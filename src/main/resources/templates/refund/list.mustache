{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header mb-0">
            <h4><b>환불요청 내역(사용자)</b></h4>
        </div>
        {{#refundList}}
            <div class="card mb-2">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div class="flex-grow-1">
                            <h5 class="card-title mb-2">
                                환불 요청 #{{id}}
                            </h5>
                            <p class="text-muted mb-2">
                                <i class="fa-solid fa-list"></i>결제 ID : {{paymentId}}
                            </p>
                            <p class="text-muted mb-2">
                                <i class="fa-solid fa-key"></i>환불 금액 : {{amount}} P
                            </p>
                            <p class="text-muted mb-2">
                                <i class="fa-solid fa-calendar-days"></i>환불 사유: {{reason}}
                            </p>
                            <p class="text-muted mb-2">
                                {{#isPending}}
                                    <i class="fas fa-user"></i>상태: <span class="badge bg-warning">{{statusDisplay}}</span>
                                {{/isPending}}
                                {{#isApproved}}
                                    <i class="fas fa-user"></i>상태: <span class="badge bg-success">{{statusDisplay}}</span>
                                {{/isApproved}}
                                {{#isRejected}}
                                    <i class="fas fa-user"></i>상태: <span class="badge bg-danger">{{statusDisplay}}</span>
                                {{/isRejected}}
                            </p>
                            <p class="text-muted mb-2">
                                거절 사유 :  <span class="text-danger">{{rejectReason}}</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        {{/refundList}}
        <a href="/user/detail" class="btn btn-secondary">회원정보로 돌아가기</a>

    </div>
</div>
{{> layout/footer}}
















